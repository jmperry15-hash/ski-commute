# Copy this file to .env.local and paste in your keys:
#   cp .env.example .env.local
# .env.local is listed in .gitignore, so it is never uploaded to GitHub.

# SERVER key — secret. Used only by src/app/api/commute/route.ts.
# Restrict it in Google Cloud to: Routes API + Geocoding API.
GOOGLE_MAPS_API_KEY=

# BROWSER key — visible to anyone who views the page, so lock it down.
# Restrict it in Google Cloud to: Maps JavaScript API + your website URLs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
